{
  "name": "tech-pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "build": "next build",
    "start": "next start",
    "fetch": "node --env-file=.env.local --import tsx scripts/fetch.ts",
    "test": "bun test",
    "migrate:tenancy": "node --env-file=.env.local --import tsx scripts/migrate-tenancy.ts",
    "verify:catalyst": "node --env-file=.env.local --import tsx scripts/verify-catalyst-notes.ts",
    "start:appsail": "PORT=${X_ZOHO_CATALYST_LISTEN_PORT:-3000} node server.js",
    "pack:appsail": "rm -rf build && next build && mkdir -p build && cp -r .next/standalone/. build/ && mkdir -p build/.next && cp -r .next/static build/.next/static && if [ -d public ]; then cp -r public build/public; fi && rm -f build/.env build/.env.local build/.env.production build/.env.development && echo 'pack: stripped env files from bundle' && ! ls build/.env* >/dev/null 2>&1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@libsql/client": "^0.17.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.17.1",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zcatalyst-sdk-node": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cheerio": "^1.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
